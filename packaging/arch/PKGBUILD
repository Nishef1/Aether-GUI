# Maintainer: Aether-GUI contributors
pkgname=aether-gui-git
pkgver=0.8.0.r0.gHEAD
pkgrel=1
pkgdesc='Cross-platform GUI for the Aether censorship-circumvention tunnel'
arch=('x86_64')
url='https://github.com/Nishef1/Aether-GUI'
license=('AGPL-3.0-only')
options=('!debug')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'polkit'
  'curl'
)
makedepends=(
  'git'
  'wget'
  'file'
  'nodejs'
  'npm'
  'rust'
  'cmake'
  'openssl'
  'librsvg'
  'xdotool'
  'patchelf'
)
source=("git+https://github.com/Nishef1/Aether-GUI.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/Aether-GUI"
  local base
  base="$(node -p "require('./src-tauri/tauri.conf.json').version")"
  printf '%s.r%s.g%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/Aether-GUI"
  node scripts/ci/sync-product-version.mjs
  npm ci --no-audit --no-fund
  npm run verify:runtimes
}

build() {
  cd "$srcdir/Aether-GUI"
  # Build Tauri's Debian filesystem layout, then repackage that exact payload
  # with pacman. This keeps Tauri's resource placement authoritative instead
  # of guessing where bundled sidecars belong on Linux.
  npm run tauri -- build --bundles deb
}

check() {
  cd "$srcdir/Aether-GUI"
  npm run typecheck
  cargo test --manifest-path src-tauri/Cargo.toml --locked
}

package() {
  cd "$srcdir/Aether-GUI"
  local deb data_member
  deb="$(find src-tauri/target/release/bundle/deb -maxdepth 1 -type f -name '*.deb' -print -quit)"
  [[ -n "$deb" ]] || { echo 'Tauri Debian bundle was not produced' >&2; return 1; }

  data_member="$(ar t "$deb" | awk '/^data\.tar\./ { print; exit }')"
  [[ -n "$data_member" ]] || { echo 'Debian data archive was not found' >&2; return 1; }

  ar p "$deb" "$data_member" | bsdtar -xpf - -C "$pkgdir"
}
