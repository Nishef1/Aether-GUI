{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether-GUI",
  "version": "1.0.0",
  "identifier": "com.cluvexstudio.aethergui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether-GUI",
        "width": 560,
        "height": 760,
        "minWidth": 420,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0D0D0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0 | libgtk-3-0t64",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "pkexec",
          "curl"
        ]
      },
      "rpm": {
        "depends": [
          "polkit",
          "curl"
        ]
      }
    }
  }
}
