{
  "name": "aether-gui",
  "private": true,
  "version": "0.5.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:custom": "pnpm core:aether && tauri dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-dev.ps1",
    "android:apk:path": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/find-android-apk.ps1",
    "android:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-android-apk.ps1",
    "prepare:android:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-android-icons.ps1",
    "patch:android:wg": "python scripts/ci/patch-aether-wg-real-egress.py",
    "prepare:android:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-android-native-final.ps1",
    "build:android:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-arm64.ps1",
    "core:aether": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-local-aether.ps1",
    "core:aether:local": "pnpm core:aether",
    "core:aether:bundle:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-embedded-aether.ps1",
    "prepare:cores:windows": "pnpm core:aether:bundle:windows && powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/binaries/fetch-singbox.ps1 -Version v1.13.14 && powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/binaries/fetch-xray.ps1 -Version v26.6.1",
    "prepare:cores:unix": "bash src-tauri/binaries/fetch-aether.sh --version v1.4.0 && bash src-tauri/binaries/fetch-singbox.sh --version v1.13.14 && bash src-tauri/binaries/fetch-xray.sh --version v26.6.1",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:bundled-cores:windows": "node scripts/verify-bundled-cores.mjs",
    "build:windows:exe": "pnpm prepare:cores:windows && pnpm verify:bundled-cores:windows && tauri build --no-bundle",
    "build:windows:setup:unsigned": "pnpm prepare:cores:windows && pnpm verify:bundled-cores:windows && tauri build --bundles nsis --config src-tauri/tauri.conf.unsigned.json",
    "build:windows:setup": "pnpm prepare:cores:windows && pnpm verify:bundled-cores:windows && node scripts/require-tauri-signing.mjs && tauri build --bundles nsis",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clippy:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "validate": "pnpm verify:version && pnpm typecheck && pnpm lint && pnpm check:rust && pnpm test:rust && pnpm clippy:rust && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "release:windows": "pnpm validate && pnpm build:windows:setup"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
